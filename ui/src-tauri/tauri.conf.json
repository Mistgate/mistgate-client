{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mistgate",
  "version": "0.1.1",
  "identifier": "net.mistgate.client",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:5183",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Mistgate",
        "width": 1000,
        "height": 660,
        "resizable": false,
        "maximizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "center": true,
        "visible": false
      },
      {
        "label": "tray",
        "title": "Mistgate quick panel",
        "url": "index.html?screen=Tray",
        "width": 372,
        "height": 560,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "skipTaskbar": true,
        "alwaysOnTop": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "publisher": "Mistgate",
    "shortDescription": "Mistgate VPN client",
    "license": "AGPL-3.0-only",
    "resources": {
      "bin/mistgate-clientd.exe": "mistgate-clientd.exe",
      "bin/wintun.dll": "wintun.dll"
    },
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "installerHooks": "installer.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDJFRjFDNEMwRjc3M0FENkEKUldScXJYUDN3TVR4THBxWE40bHdlYWRVMGozVkJjOTRnUXpLenpXemxzVGxGWlhkbmhrdU1qMWgK",
      "endpoints": [
        "https://github.com/Mistgate/mistgate-client/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
